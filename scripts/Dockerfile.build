# Reproducible build/test environment for UtterAI (Linux).
# Used locally (no host sudo needed) and mirrored by CI.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential curl wget file ca-certificates git pkg-config \
      cmake clang libclang-dev \
      libssl-dev \
      libwebkit2gtk-4.1-dev libjavascriptcoregtk-4.1-dev \
      libgtk-3-dev libglib2.0-dev libgdk-pixbuf-2.0-dev \
      libpango1.0-dev libcairo2-dev libatk1.0-dev \
      libsoup-3.0-dev librsvg2-dev \
      libayatana-appindicator3-dev \
      libasound2-dev \
      patchelf desktop-file-utils fakeroot \
      xvfb webkit2gtk-driver \
    && rm -rf /var/lib/apt/lists/*

# Node 22 (for the Tauri frontend build)
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Rust, installed system-wide so any UID (host user in CI/local) can use it.
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
      sh -s -- -y --no-modify-path --profile minimal --default-toolchain stable \
    && rustup component add rustfmt clippy \
    && chmod -R a+rwX /usr/local/rustup /usr/local/cargo \
    && echo 'export PATH=/usr/local/cargo/bin:$PATH' > /etc/profile.d/rust.sh

WORKDIR /work
